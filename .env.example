# CareerPath – Environment Configuration Example
# Set these variables in your Render Dashboard under "Environment"

# Database Connection (Option 1: Individual Parameters - Recommended)
DB_HOST=your-mysql-hostname.render.com
DB_PORT=3306
DB_NAME=student_career_finder
DB_USER=your_db_username
DB_PASSWORD=your_secure_password
DB_CHARSET=utf8mb4
DB_SSL=false

# Database Connection (Option 2: Single Connection URL)
# DATABASE_URL=mysql://username:password@hostname:3306/dbname

# Application URL (Optional - Leave blank for automatic HTTPS detection on Render)
# APP_URL=https://your-app-name.onrender.com

